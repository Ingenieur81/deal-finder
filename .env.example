# Change these before first launch. Browser authentication uses HTTP Basic Auth.
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-unique-password
DATA_DIR=/data
LOG_LEVEL=INFO
SCHEDULER_TIMEZONE=Europe/Amsterdam

# Google Shopping searches use SerpAPI. Create a key at https://serpapi.com/.
SERPAPI_API_KEY=your_serpapi_key

# Email alerts. Set SMTP_STARTTLS=false only for a trusted non-TLS local relay.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=alerts@example.com
SMTP_STARTTLS=true

# Android alerts: mount the Firebase service account in docker-compose.yml and set this exact path.
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
